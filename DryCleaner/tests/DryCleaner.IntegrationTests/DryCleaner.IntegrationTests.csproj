<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit.v3" Version="3.0.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
		<PackageReference Include="coverlet.collector" Version="6.0.4" />
		<PackageReference Include="Aspire.Hosting.Testing" Version="13.6.4" />
		<PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
		<PackageReference Include="Google.Protobuf" Version="3.36.1" />
		<PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\DryCleaner.AppHost\DryCleaner.AppHost.csproj" />
		<ProjectReference Include="..\..\src\DryCleaner.Contracts\DryCleaner.Contracts.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<Protobuf Include="..\..\src\DryCleaner.Contracts\Protos\orders.proto" GrpcServices="Client">
			<Link>Protos\orders.proto</Link>
		</Protobuf>
	</ItemGroup>
</Project>