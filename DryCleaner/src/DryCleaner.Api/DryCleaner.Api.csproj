<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Aspire.Pomelo.EntityFrameworkCore.MySql" Version="13.5.0" />
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.13" />
	  <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.13" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.6" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DryCleaner.Infrastructure.EFCore\DryCleaner.Infrastructure.EFCore.csproj" />
    <ProjectReference Include="..\DryCleaner.ServiceDefaults\DryCleaner.ServiceDefaults.csproj" />
    <ProjectReference Include="..\DryCleaner.Application\DryCleaner.Application.csproj" />
    <ProjectReference Include="..\DryCleaner.Contracts\DryCleaner.Contracts.csproj" />
    <ProjectReference Include="..\DryCleaner.Domain\DryCleaner.Domain.csproj" />
  </ItemGroup>

</Project>
