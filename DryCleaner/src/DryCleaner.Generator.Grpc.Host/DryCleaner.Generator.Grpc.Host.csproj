<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<Protobuf Include="..\DryCleaner.Contracts\Protos\orders.proto" GrpcServices="Server">
		  <Link>Protos\orders.proto</Link>
		</Protobuf>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DryCleaner.Generator\DryCleaner.Generator.csproj" />
		<ProjectReference Include="..\DryCleaner.Contracts\DryCleaner.Contracts.csproj" />
	</ItemGroup>

</Project>